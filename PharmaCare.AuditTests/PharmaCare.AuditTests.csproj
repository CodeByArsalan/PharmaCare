<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PharmaCare.Application\PharmaCare.Application.csproj" />
    <ProjectReference Include="..\PharmaCare.Infrastructure\PharmaCare.Infrastructure.csproj" />
    <ProjectReference Include="..\PharmaCare.Domain\PharmaCare.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="PharmaCare.Domain" />
  </ItemGroup>

  <!-- EF Core SqlServer and Microsoft.Extensions.DependencyInjection flow transitively
       (at the solution-wide 8.0.x versions) through the Infrastructure project reference —
       do not pin cross-major versions here. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
