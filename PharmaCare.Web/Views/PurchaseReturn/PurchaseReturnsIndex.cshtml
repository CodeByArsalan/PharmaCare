@using PharmaCare.Web.Utilities
@model PharmaCare.Application.DTOs.PagedResult<PharmaCare.Domain.Entities.Transactions.StockMain>
@{
    ViewData["Title"] = "Purchase Returns";
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">
        <i class="fas fa-undo-alt"></i>
        Purchase Returns
    </h4>
    <a asp-action="AddPurchaseReturn" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Purchase Return
    </a>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
        <form method="get" asp-action="PurchaseReturnsIndex" class="row gx-3 gy-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Supplier</label>
                <select name="supplierId" class="form-select select2" asp-items="ViewBag.Suppliers">
                    <option value="">-- All Suppliers --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Status</label>
                <select name="status" class="form-select">
                    <option value="All" selected="@(ViewBag.SelectedStatus == "All")">All</option>
                    <option value="Approved" selected="@(ViewBag.SelectedStatus == "Approved")">Approved</option>
                    <option value="Void" selected="@(ViewBag.SelectedStatus == "Void")">Voided</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="purchaseReturnsTable">
            <thead>
                <tr>
                    <th style="width: 50px;">S.No</th>
                    <th>Return Number</th>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th>Reference GRN</th>
                    <th class="text-end">Amount</th>
                    <th>Status</th>
                    <th class="text-end" style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    var sno = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(sno++)</td>
                            <td><strong>@item.TransactionNo</strong></td>
                            <td>@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.Party?.Name</td>
                            <td>@(item.ReferenceStockMain?.TransactionNo ?? "-")</td>
                            <td class="text-end">@item.TotalAmount.ToString("N2")</td>
                            <td>
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Status == "Void")
                                {
                                    <span class="badge bg-danger cursor-pointer" data-bs-toggle="tooltip" title="Reason: @(item.VoidReason ?? "No reason provided")">Void</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="ViewPurchaseReturn" asp-route-id="@item.StockMainID.EncryptId()" class="btn btn-sm btn-outline-info" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (item.Status == "Approved")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-void" 
                                            data-id="@item.StockMainID.EncryptId()" data-no="@item.TransactionNo" title="Void">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Void Modal -->
<div class="modal fade" id="voidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Void">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="voidId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-ban me-2"></i>Void Purchase Return</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to void <strong id="voidNo"></strong>?</p>
                    <div class="mb-3">
                        <label class="form-label">Reason <span class="text-danger">*</span></label>
                        <textarea name="voidReason" class="form-control" rows="3" required placeholder="Enter reason for voiding..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Void Return</button>
                </div>
            </form>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-theme-footer py-3 border-top-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="text-muted small">
                        Showing <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)</strong> to 
                        <strong>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount))</strong> of 
                        <strong>@Model.TotalCount</strong> entries
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.CurrentPage - 1)&supplierId=@ViewBag.SelectedSupplier&status=@ViewBag.SelectedStatus&fromDate=@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")&toDate=@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")">Previous</a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                            </li>
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="?page=@(Model.CurrentPage + 1)&supplierId=@ViewBag.SelectedSupplier&status=@ViewBag.SelectedStatus&fromDate=@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")&toDate=@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            $('.select2').select2({ theme: 'bootstrap-5' });

            if (!$.fn.DataTable.isDataTable('#purchaseReturnsTable')) {
                $('#purchaseReturnsTable').DataTable({
                    order: [[2, 'desc']],
                    paging: false,
                    info: false,
                    searching: false
                });
            }

            document.querySelectorAll('.btn-void').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const no = this.getAttribute('data-no');
                
                document.getElementById('voidId').value = id;
                document.getElementById('voidNo').textContent = no;
                
                new bootstrap.Modal(document.getElementById('voidModal')).show();
            });
        });
    </script>
}
