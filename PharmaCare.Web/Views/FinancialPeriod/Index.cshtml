@model IEnumerable<PharmaCare.Domain.Entities.Accounting.FinancialPeriod>
@{
    ViewData["Title"] = "Financial Periods";
}

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="page-title mb-0">
        <i class="fas fa-calendar-alt me-2"></i>
        Financial Period Management
    </h4>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPeriodModal">
        <i class="fas fa-plus me-2"></i>Add New Period
    </button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle datatable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Year Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th class="text-center">Status</th>
                        <th>Remarks</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int count = 1; }
                    @foreach (var item in Model.OrderByDescending(p => p.StartDate))
                    {
                        <tr>
                            <td>@(count++)</td>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.StartDate.ToString("dd-MMM-yyyy")</td>
                            <td>@item.EndDate.ToString("dd-MMM-yyyy")</td>
                            <td class="text-center">
                                @if (item.IsClosed)
                                {
                                    <span class="badge bg-danger rounded-pill px-3">
                                        <i class="fas fa-lock me-1"></i> Closed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3">
                                        <i class="fas fa-lock-open me-1"></i> Open
                                    </span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@(string.IsNullOrEmpty(item.Remarks) ? "-" : item.Remarks)</small>
                            </td>
                            <td class="text-end">
                                @if (item.IsClosed)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success btn-open" 
                                            data-id="@item.PeriodID" data-name="@item.Name">
                                        <i class="fas fa-unlock me-1"></i> Open
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-close-period" 
                                            data-id="@item.PeriodID" data-name="@item.Name">
                                        <i class="fas fa-lock me-1"></i> Close
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                 </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Period Modal -->
<div class="modal fade" id="addPeriodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Add Financial Period</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addPeriodForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Period Name (e.g., FY 2024-25)</label>
                        <input type="text" name="Name" class="form-control" placeholder="Enter period name" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Start Date</label>
                                <input type="date" name="StartDate" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">End Date</label>
                                <input type="date" name="EndDate" class="form-control" required />
                            </div>
                        </div>
                    </div>
                    <div class="mb-0">
                        <label class="form-label font-weight-bold">Initial Remarks</label>
                        <textarea name="Remarks" class="form-control" rows="2" placeholder="Optional remarks"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Period</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Handle Add Period Form Submission
            $('#addPeriodForm').submit(function (e) {
                e.preventDefault();
                const formData = $(this).serialize();
                
                $.post('/FinancialPeriod/Create', formData, function (res) {
                    if (res.success) {
                        Swal.fire({
                            title: 'Success!',
                            text: res.message,
                            icon: 'success',
                            confirmButtonColor: '#3085d6'
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                });
            });

            // Handle Close Period
            $('.btn-close-period').click(function () {
                const id = $(this).data('id');
                const name = $(this).data('name');

                Swal.fire({
                    title: 'Close Period?',
                    text: `Are you sure you want to lock the financial period "${name}"? No further transactions can be posted in this range.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, Close it!',
                    input: 'text',
                    inputLabel: 'Closure Remarks (Optional)',
                    inputPlaceholder: 'Enter reason for closing...'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('/FinancialPeriod/Close', { id: id, remarks: result.value }, function (res) {
                            if (res.success) {
                                location.reload();
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        });
                    }
                });
            });

            // Handle Open Period
            $('.btn-open').click(function () {
                const id = $(this).data('id');
                const name = $(this).data('name');

                Swal.fire({
                    title: 'Re-open Period?',
                    text: `Do you want to re-open the financial period "${name}" for transactions?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#22c55e',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, Open it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('/FinancialPeriod/Open', { id: id }, function (res) {
                            if (res.success) {
                                location.reload();
                            } else {
                                Swal.fire('Error', res.message, 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
