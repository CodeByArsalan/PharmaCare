@using PharmaCare.Web.Utilities
@model PharmaCare.Application.DTOs.PagedResult<PharmaCare.Domain.Entities.Transactions.StockMain>
@{
    ViewData["Title"] = "Purchases (GRN)";
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">
        <i class="fas fa-truck-loading"></i>
        Purchases (GRN)
    </h4>
    <a asp-action="AddPurchase" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Purchase
    </a>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light">
        <form method="get" asp-action="PurchasesIndex" class="row gx-3 gy-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Supplier</label>
                <select name="supplierId" class="form-select select2" asp-items="ViewBag.Suppliers">
                    <option value="">-- All Suppliers --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Status</label>
                <select name="status" class="form-select">
                    <option value="All" selected="@(ViewBag.SelectedStatus == "All" ? "selected" : null)">All</option>
                    <option value="Approved" selected="@(ViewBag.SelectedStatus == "Approved" ? "selected" : null)">Approved</option>
                    <option value="Void" selected="@(ViewBag.SelectedStatus == "Void" ? "selected" : null)">Void</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.TotalCount > 0)
        {
            @await Html.PartialAsync("_PagerTop", Model)
        }
        <div class="table-responsive">
        <table class="table table-hover mb-0" id="purchasesTable">
            <thead>
                <tr>
                    <th scope="col" style="width: 50px;">S.No</th>
                    <th scope="col">GRN Number</th>
                    <th scope="col">Date</th>
                    <th scope="col">Supplier</th>
                    <th scope="col">Reference PO</th>
                    <th scope="col" class="text-end">Amount</th>
                    <th scope="col" class="text-end">Paid</th>
                    <th scope="col" class="text-end">Balance</th>
                    <th scope="col">Payment</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end" style="width: 250px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    var sno = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(sno++)</td>
                            <td><strong>@item.TransactionNo</strong></td>
                            <td>@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.Party?.Name</td>
                            <td>@(item.ReferenceStockMain?.TransactionNo ?? "-")</td>
                            <td class="text-end">@item.TotalAmount.ToString("N2")</td>
                            <td class="text-end text-success">@item.PaidAmount.ToString("N2")</td>
                            <td class="text-end @(item.BalanceAmount > 0 ? "text-danger fw-bold" : "text-success")">@item.BalanceAmount.ToString("N2")</td>
                            <td>
                                @{
                                    var payStatusClass = item.PaymentStatus switch
                                    {
                                        "Paid" => "success",
                                        "Partial" => "warning",
                                        _ => "danger"
                                    };
                                }
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-@payStatusClass">@item.PaymentStatus</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Status == "Void")
                                {
                                    <span class="badge bg-danger cursor-pointer" data-bs-toggle="tooltip" title="Reason: @(item.VoidReason ?? "No reason provided")">Void</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="ViewPurchase" asp-route-id="@item.StockMainID.EncryptId()" class="btn btn-sm btn-outline-info" title="View" aria-label="View purchase">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (item.Status == "Approved" && item.PaymentStatus != "Paid")
                                {
                                    <a asp-action="EditPurchase" asp-route-id="@item.StockMainID.EncryptId()" class="btn btn-sm btn-outline-warning" title="Edit" aria-label="Edit purchase">
                                        <i class="fas fa-pencil-alt"></i>
                                    </a>
                                }
                                @if (item.Status == "Approved" && item.BalanceAmount > 0)
                                {
                                    <a asp-controller="SupplierPayment" asp-action="MakePayment" asp-route-stockMainId="@item.StockMainID.EncryptId()" class="btn btn-sm btn-success" title="Make Payment" aria-label="Make Payment">
                                        <i class="fas fa-money-bill"></i>
                                    </a>
                                }
                                @if (item.Status == "Approved")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-void" title="Void" aria-label="Void purchase"
                                            data-id="@item.StockMainID.EncryptId()" data-no="@item.TransactionNo">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center py-4">
                            <div class="empty-state">
                                <i class="fas fa-truck-loading fa-3x text-muted mb-3"></i>
                                <p class="mb-0">No purchases found. Click "Add Purchase" to create one.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    @if (Model.TotalCount > 0)
    {
        @await Html.PartialAsync("_Pager", Model)
    }
</div>

<!-- Void Modal -->
<div class="modal fade" id="voidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Void">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="voidId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-ban me-2"></i>Void Purchase</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to void <strong id="voidNo"></strong>?</p>
                    <div class="mb-3">
                        <label class="form-label">Reason <span class="text-danger">*</span></label>
                        <textarea name="voidReason" class="form-control" rows="3" required placeholder="Enter reason for voiding..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Void Purchase</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Select2 is initialized globally by select2-global.js (width:100%) — no re-init here.
            
        document.querySelectorAll('.btn-void').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const no = this.getAttribute('data-no');
                
                document.getElementById('voidId').value = id;
                document.getElementById('voidNo').textContent = no;
                
                new bootstrap.Modal(document.getElementById('voidModal')).show();
            });
        });
        });
    </script>
}
