@using PharmaCare.Web.Utilities
@model PharmaCare.Application.DTOs.PagedResult<PharmaCare.Domain.Entities.Transactions.StockMain>
@{
    ViewData["Title"] = "Sale Returns";
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">
        <i class="fas fa-undo"></i>
        Sale Returns
    </h4>
    <a asp-action="AddSaleReturn" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>New Sale Return
    </a>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light">
        <form method="get" asp-action="SaleReturnsIndex" class="row gx-3 gy-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Customer</label>
                <select name="customerId" class="form-select select2" asp-items="ViewBag.Customers">
                    <option value="">-- All Customers --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Status</label>
                <select name="status" class="form-select">
                    <option value="All" selected="@(ViewBag.SelectedStatus == "All")">All</option>
                    <option value="Approved" selected="@(ViewBag.SelectedStatus == "Approved")">Approved</option>
                    <option value="Void" selected="@(ViewBag.SelectedStatus == "Void")">Voided</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.TotalCount > 0)
        {
            @await Html.PartialAsync("_PagerTop", Model)
        }
        <div class="table-responsive">
            <table id="saleReturnsTable" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th scope="col">S.No</th>
                        <th scope="col">Transaction No</th>
                        <th scope="col">Date</th>
                        <th scope="col">Customer</th>
                        <th scope="col">Original Sale</th>
                        <th scope="col" class="text-end">Total Amount</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int serialNo = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(serialNo++)</td>
                            <td>@item.TransactionNo</td>
                            <td>@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                            <td>@(item.Party?.Name ?? "Walk-in Customer")</td>
                            <td>@(item.ReferenceStockMain?.TransactionNo ?? "-")</td>
                            <td class="text-end">@item.TotalAmount.ToString("N2")</td>
                            <td>
                                @if (item.Status == "Void")
                                {
                                    <span class="badge bg-danger cursor-pointer" data-bs-toggle="tooltip" title="Reason: @(item.VoidReason ?? "No reason provided")">Void</span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td>
                                <a asp-action="ViewSaleReturn" asp-route-id="@item.StockMainID.EncryptId()" 
                                   class="btn btn-sm btn-outline-primary" title="View" aria-label="View sale return">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (item.Status != "Void")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger void-btn"
                                            data-id="@item.StockMainID.EncryptId()" 
                                            data-transaction="@item.TransactionNo"
                                            title="Void" aria-label="Void sale return">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalCount > 0)
        {
            @await Html.PartialAsync("_Pager", Model)
        }
    </div>
</div>

<!-- Void Modal -->
<div class="modal fade" id="voidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Void" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Void Sale Return</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="voidId" />
                    <p>Are you sure you want to void sale return <strong id="voidTransactionNo"></strong>?</p>
                    <div class="mb-3">
                        <label class="form-label">Reason for voiding <span class="text-danger">*</span></label>
                        <textarea name="voidReason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Void Sale Return</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Select2 is initialized globally by select2-global.js (width:100%) — no re-init here.

            // Initialize DataTable
            new DataTable('#saleReturnsTable', {
                order: [[2, 'desc']],
                paging: false,
                info: false,
                searching: false
            });

            // Void button click
            document.querySelectorAll('.void-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.getElementById('voidId').value = this.dataset.id;
                    document.getElementById('voidTransactionNo').textContent = this.dataset.transaction;
                    new bootstrap.Modal(document.getElementById('voidModal')).show();
                });
            });
        });
    </script>
}
