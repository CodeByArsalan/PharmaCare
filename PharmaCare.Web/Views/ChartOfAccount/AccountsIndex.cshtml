@using PharmaCare.Web.Utilities
@model IEnumerable<PharmaCare.Domain.Entities.Accounting.Account>
@{
    ViewData["Title"] = "Chart of Accounts";
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">
        <i class="fas fa-book"></i>
        Chart of Accounts
    </h4>
    <a asp-action="AddAccount" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Account
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
        <table class="table table-hover datatable">
            <thead>
                <tr>
                    <th scope="col" style="width: 60px;">S.No</th>

                    <th scope="col">Head</th>
                    <th scope="col">Sub-Head</th>
                    <th scope="col">Account Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int count = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(count++)</td>

                        <td>@(item.AccountHead?.HeadName ?? "-")</td>
                        <td>@(item.AccountSubhead?.SubheadName ?? "-")</td>
                        <td><strong>@item.Name</strong></td>
                        <td>@(item.AccountType?.Name ?? "-")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="EditAccount" asp-route-id="@item.AccountID.EncryptId()" class="btn btn-sm btn-outline-primary" title="Edit account" aria-label="Edit account">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-delete"
                                    data-id="@item.AccountID.EncryptId()" data-name="@item.Name" title="Toggle account status" aria-label="Toggle account status">
                                <i class="fas fa-toggle-on"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<!-- Hidden form for delete/toggle -->
<form id="deleteForm" method="post" style="display: none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-delete').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                
                Swal.fire({
                    title: 'Toggle Status?',
                    text: `Are you sure you want to toggle status for "${name}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#eab308',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, toggle it!',
                    cancelButtonText: 'Cancel',
                    background: 'var(--bg-card)',
                    color: 'var(--text-primary)'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = document.getElementById('deleteForm');
                        form.action = '/ChartOfAccount/Delete/' + id;
                        form.submit();
                    }
                });
            });
        });
    </script>
}
