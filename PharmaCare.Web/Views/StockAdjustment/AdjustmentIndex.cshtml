@using PharmaCare.Web.Utilities
@model PharmaCare.Application.DTOs.PagedResult<PharmaCare.Domain.Entities.Transactions.StockMain>
@{
    ViewData["Title"] = "Stock Adjustments";
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
    var currentType = ViewBag.CurrentType as string;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="page-title mb-0"><i class="fas fa-boxes me-2"></i>Stock Adjustments</h4>
        
    </div>
    <a asp-action="AddAdjustment" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus me-2"></i>New Adjustment
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="AdjustmentIndex" class="row gx-3 gy-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">Adjustment Type</label>
                <select name="type" class="form-select border-0">
                    <option value="">All Types</option>
                    <option value="Write-off" selected="@(currentType == "Write-off")">Write-off (Decrease)</option>
                    <option value="Write-in" selected="@(currentType == "Write-in")">Write-in (Increase)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">From Date</label>
                <input type="date" name="from" class="form-control border-0" value="@fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">To Date</label>
                <input type="date" name="to" class="form-control border-0" value="@toDate" />
            </div>
            <div class="col-md-3">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-info w-100"><i class="fas fa-search me-2"></i>Filter</button>
                    <a asp-action="AdjustmentIndex" class="btn btn-outline-secondary" title="Reset Filters"><i class="fas fa-undo"></i></a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="adjTable">
                <thead class="bg-theme-header">
                    <tr>
                        <th class="ps-4">Ref No</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Reason</th>
                        <th class="text-end">Value (Total Cost)</th>
                        <th class="text-center">Status</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var adj in Model.Items)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold">@adj.TransactionNo</span>
                            </td>
                            <td>@adj.TransactionDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (adj.AdjustmentType == "Write-in")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="fas fa-arrow-up me-1"></i> Write-in
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="fas fa-arrow-down me-1"></i> Write-off
                                    </span>
                                }
                            </td>
                            <td>@adj.AdjustmentReason</td>
                            <td class="text-end fw-bold">@adj.TotalAmount.ToString("N2")</td>
                            <td class="text-center">
                                @if (adj.Status == "Approved")
                                {
                                    <span class="badge bg-success shadow-none">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger shadow-none cursor-pointer" data-bs-toggle="tooltip" title="Reason: @(adj.VoidReason ?? "No reason provided")">@adj.Status</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group shadow-sm">
                                    <a asp-action="ViewAdjustment" asp-route-id="@adj.StockMainID.EncryptId()" 
                                       class="btn btn-sm btn-outline-info" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (adj.Status == "Approved")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#voidModal"
                                                data-id="@adj.StockMainID.EncryptId()"
                                                data-ref="@adj.TransactionNo">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-theme-footer py-3">
        <div class="d-flex justify-content-between align-items-center">
            <div class="text-muted small">
                Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) of @Model.TotalCount records
            </div>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("AdjustmentIndex", new { page = Model.CurrentPage - 1, type = currentType, from = fromDate, to = toDate })">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("AdjustmentIndex", new { page = i, type = currentType, from = fromDate, to = toDate })">@i</a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("AdjustmentIndex", new { page = Model.CurrentPage + 1, type = currentType, from = fromDate, to = toDate })">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<div class="modal fade" id="voidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="Void" method="post">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title"><i class="fas fa-ban me-2 text-danger"></i>Void Stock Adjustment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-muted mb-4">You are about to void <strong id="voidRef"></strong>. This action will reverse stock impact and accounting entries.</p>
                    <input type="hidden" name="id" id="voidId" />
                    <div class="mb-0">
                        <label class="form-label small fw-bold">Reason for Voiding <span class="text-danger">*</span></label>
                        <textarea name="voidReason" class="form-control border-0" rows="3" required placeholder="Describe why this adjustment is being voided..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4 shadow-sm"><i class="fas fa-ban me-2"></i>Void Adjustment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Minimal DataTable for sorting only
            if (!$.fn.DataTable.isDataTable('#adjTable')) {
                $('#adjTable').DataTable({ 
                    paging: false, 
                    info: false, 
                    searching: false,
                    order: [[1, 'desc']] 
                });
            }
            $('#voidModal').on('show.bs.modal', function(e) {
                var btn = $(e.relatedTarget);
                $('#voidId').val(btn.data('id'));
                $('#voidRef').text(btn.data('ref'));
            });
        });
    </script>
}
