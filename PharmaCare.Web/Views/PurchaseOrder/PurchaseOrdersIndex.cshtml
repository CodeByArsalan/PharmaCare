@using PharmaCare.Web.Utilities
@model PharmaCare.Application.DTOs.PagedResult<PharmaCare.Domain.Entities.Transactions.StockMain>
@{
    ViewData["Title"] = "Purchase Orders";
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">
        <i class="fas fa-file-invoice"></i>
        Purchase Orders
    </h4>
    <a asp-action="AddPurchaseOrder" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Purchase Order
    </a>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light">
        <form method="get" asp-action="PurchaseOrdersIndex" class="row gx-3 gy-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">Supplier</label>
                <select name="supplierId" class="form-select select2" asp-items="ViewBag.Suppliers">
                    <option value="">-- All Suppliers --</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted">Status</label>
                <select name="status" class="form-select">
                    <option value="All" selected="@(string.IsNullOrEmpty(selectedStatus) || selectedStatus == "All")">All</option>
                    <option value="Draft" selected="@(selectedStatus == "Draft")">Draft</option>
                    <option value="Approved" selected="@(selectedStatus == "Approved")">Approved</option>
                    <option value="Completed" selected="@(selectedStatus == "Completed")">Completed</option>
                    <option value="Void" selected="@(selectedStatus == "Void")">Void</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.TotalCount > 0)
        {
            @await Html.PartialAsync("_PagerTop", Model)
        }
        <table class="table table-hover mb-0" id="purchaseOrdersTable">
            <thead>
                <tr>
                    <th class="w-50px">S.No</th>
                    <th>PO Number</th>
                    <th>Date</th>
                    <th>Supplier</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Paid</th>
                    <th class="text-end">Balance</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th class="text-end w-250px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    var sno = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(sno++)</td>
                            <td><strong>@item.TransactionNo</strong></td>
                            <td>@item.TransactionDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.Party?.Name</td>
                            <td class="text-end">@item.TotalAmount.ToString("N2")</td>
                            <td class="text-end text-success">@item.PaidAmount.ToString("N2")</td>
                            <td class="text-end @(item.BalanceAmount > 0 ? "text-danger fw-bold" : "text-success")">@item.BalanceAmount.ToString("N2")</td>
                            <td>
                                @{
                                    var payStatusClass = item.PaymentStatus switch
                                    {
                                        "Paid" => "success",
                                        "Partial" => "warning",
                                        _ => "secondary"
                                    };
                                }
                                @if (item.Status != "Draft" && item.Status != "Void")
                                {
                                    <span class="badge bg-@payStatusClass">@item.PaymentStatus</span>
                                }
                            </td>
                            <td>
                                @if (item.Status == "Draft")
                                {
                                    <span class="badge bg-warning">Draft</span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-primary">Completed</span>
                                }
                                else if (item.Status == "Void")
                                {
                                    <span class="badge bg-danger">Void</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="ViewPurchaseOrder" asp-route-id="@item.StockMainID.EncryptId()" class="btn btn-sm btn-outline-info" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (item.Status == "Draft")
                                {
                                    <a asp-action="EditPurchaseOrder" asp-route-id="@item.StockMainID.EncryptId()" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-success btn-approve" 
                                            data-id="@item.StockMainID.EncryptId()" data-no="@item.TransactionNo" title="Approve">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-delete" 
                                            data-id="@item.StockMainID.EncryptId()" data-no="@item.TransactionNo" title="Cancel">
                                        <i class="fas fa-times"></i>
                                    </button>
                                }
                                @if (item.Status == "Approved" && item.BalanceAmount > 0)
                                {
                                    <a asp-action="MakePayment" asp-route-id="@item.StockMainID.EncryptId()" class="btn btn-sm btn-success ms-1" title="Pay Advance">
                                        <i class="fas fa-money-bill-wave"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center py-4">
                            <div class="empty-state">
                                <i class="fas fa-file-invoice fa-3x text-muted mb-3"></i>
                                <p class="mb-0">No purchase orders found. Click "Add Purchase Order" to create one.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalCount > 0)
    {
        @await Html.PartialAsync("_Pager", Model)
    }
</div>

<!-- Hidden forms for approve and delete -->
<form id="approveForm" method="post" asp-action="Approve" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="approveId" />
</form>

<form id="deleteForm" method="post" asp-action="Delete" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            $('.select2').select2({ theme: 'bootstrap-5' });
        });

        // Approve button handler
        document.querySelectorAll('.btn-approve').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const no = this.getAttribute('data-no');
                
                Swal.fire({
                    title: 'Approve Purchase Order?',
                    text: `Are you sure you want to approve "${no}"?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#10b981',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, approve it!',
                    cancelButtonText: 'Cancel',
                    background: '#1e293b',
                    color: '#f1f5f9'
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('approveId').value = id;
                        document.getElementById('approveForm').submit();
                    }
                });
            });
        });

        // Delete button handler
        document.querySelectorAll('.btn-delete').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const no = this.getAttribute('data-no');
                
                Swal.fire({
                    title: 'Cancel Purchase Order?',
                    text: `Are you sure you want to cancel "${no}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, cancel it!',
                    cancelButtonText: 'No',
                    background: '#1e293b',
                    color: '#f1f5f9'
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('deleteId').value = id;
                        document.getElementById('deleteForm').submit();
                    }
                });
            });
        });
    </script>
}
