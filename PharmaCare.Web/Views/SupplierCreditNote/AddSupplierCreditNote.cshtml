@model PharmaCare.Domain.Entities.Finance.SupplierCreditNote
@inject PharmaCare.Infrastructure.Interfaces.IComboboxRepository _combobox
@{
    ViewData["Title"] = "Add Supplier Credit Note";
}

<div class="page-header">
    <h4 class="page-title"><i class="fas fa-file-invoice-dollar"></i> Add Supplier Credit Note</h4>
    <a asp-action="SupplierCreditNotesIndex" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header"><h6 class="mb-0"><i class="fas fa-edit me-2"></i>Credit Note Details</h6></div>
            <div class="card-body">
                <form asp-action="AddSupplierCreditNote" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Supplier <span class="text-danger">*</span></label>
                            <select asp-for="Party_ID" asp-items='_combobox.GetActivePartiesByType("Supplier")' class="form-select" required>
                                <option value="">-- Select Supplier --</option>
                            </select>
                            <span asp-validation-for="Party_ID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Credit Date <span class="text-danger">*</span></label>
                            <input asp-for="CreditDate" type="date" class="form-control" required />
                            <span asp-validation-for="CreditDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Amount <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">@CurrencyDisplay.Symbol</span>
                                <input asp-for="TotalAmount" type="number" step="0.01" min="0.01" class="form-control" required />
                            </div>
                            <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Linked GRN (Optional)</label>
                            <select asp-for="SourceStockMain_ID" asp-items="_combobox.GetPurchases()" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Adjustment Account <span class="text-danger">*</span></label>
                            <select asp-for="AdjustmentAccount_ID" asp-items="_combobox.GetActiveAccounts()" class="form-select" required>
                                <option value="">-- Select Contra Account --</option>
                            </select>
                            <span asp-validation-for="AdjustmentAccount_ID" class="text-danger small"></span>
                            <small class="text-muted">Credited by the note — e.g. Purchase Returns &amp; Allowances or rebate income.</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Reason for credit note (e.g. short delivery, damaged goods)"></textarea>
                        </div>
                    </div>
                    <hr class="my-4" />
                    <div class="text-end">
                        <a asp-action="SupplierCreditNotesIndex" class="btn btn-outline-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check me-2"></i>Record Credit Note
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>How It Works</h6></div>
            <div class="card-body">
                <div class="alert alert-info mb-3">
                    <i class="fas fa-lightbulb me-2"></i>
                    A supplier credit note reduces the amount owed to the supplier. No stock movement occurs.
                </div>
                <table class="table table-sm table-borderless mb-0">
                    <tr><td class="text-muted">Journal Entry:</td><td></td></tr>
                    <tr><td><i class="fas fa-arrow-up text-success me-1"></i> DR</td><td>Supplier Account (Payable ↓)</td></tr>
                    <tr><td><i class="fas fa-arrow-down text-danger me-1"></i> CR</td><td>Adjustment Account (contra)</td></tr>
                </table>
            </div>
        </div>
    </div>
</div>
