@using PharmaCare.Web.Utilities
@model PharmaCare.Domain.Entities.Finance.SupplierCreditNote
@{
    ViewData["Title"] = $"Credit Note — {Model.CreditNoteNo}";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h4 class="page-title">
        <i class="fas fa-file-invoice-dollar"></i> @Model.CreditNoteNo
        <span class="badge bg-@(Model.Status == "Open" ? "success" : Model.Status == "Applied" ? "secondary" : "danger") ms-2">@Model.Status</span>
    </h4>
    <a asp-action="SupplierCreditNotesIndex" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Credit Note Details</h6></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Reference No</dt>
                    <dd class="col-sm-8"><strong>@Model.CreditNoteNo</strong></dd>
                    <dt class="col-sm-4">Supplier</dt>
                    <dd class="col-sm-8">@Model.Party?.Name</dd>
                    <dt class="col-sm-4">Credit Date</dt>
                    <dd class="col-sm-8">@Model.CreditDate.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4">Linked GRN</dt>
                    <dd class="col-sm-8">
                        @if (Model.SourceStockMain != null)
                        {
                            <a asp-controller="Purchase" asp-action="ViewPurchase" asp-route-id="@Model.SourceStockMain_ID!.Value.EncryptId()">
                                @Model.SourceStockMain.TransactionNo
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">— Not linked</span>
                        }
                    </dd>
                    <dt class="col-sm-4">Remarks</dt>
                    <dd class="col-sm-8">@(Model.Remarks ?? "—")</dd>
                    @if (Model.Status == "Void")
                    {
                        <dt class="col-sm-4 text-danger">Void Reason</dt>
                        <dd class="col-sm-8 text-danger">@Model.VoidReason</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Financial Summary</h6></div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tr>
                        <td class="text-muted">Total Amount</td>
                        <td class="text-end fw-bold">@Model.TotalAmount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Applied</td>
                        <td class="text-end text-muted">@Model.AppliedAmount.ToString("N2")</td>
                    </tr>
                    <tr class="border-top">
                        <td class="fw-bold">Balance</td>
                        <td class="text-end fw-bold @(Model.BalanceAmount > 0 ? "text-success" : "")">
                            @Model.BalanceAmount.ToString("N2")
                        </td>
                    </tr>
                </table>

                @if (Model.Status == "Open")
                {
                    <hr />
                    <button type="button" class="btn btn-outline-danger w-100"
                            data-bs-toggle="modal" data-bs-target="#voidModal">
                        <i class="fas fa-ban me-2"></i>Void Credit Note
                    </button>
                }
            </div>
        </div>

        @if (Model.Voucher != null)
        {
            <div class="card mt-3">
                <div class="card-header"><h6 class="mb-0">Accounting Voucher</h6></div>
                <div class="card-body">
                    <p class="mb-1 text-muted small">Voucher No: <strong>@Model.Voucher.VoucherNo</strong></p>
                    <p class="mb-0 text-muted small">Status: @Model.Voucher.Status</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Void Modal -->
<div class="modal fade" id="voidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Void" method="post">
                <input type="hidden" name="id" value="@Model.SupplierCreditNoteID.EncryptId()" />
                <div class="modal-header">
                    <h5 class="modal-title text-danger"><i class="fas fa-ban me-2"></i>Void Credit Note</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will void <strong>@Model.CreditNoteNo</strong> and reverse all accounting entries.</p>
                    <div class="mb-3">
                        <label class="form-label">Void Reason <span class="text-danger">*</span></label>
                        <textarea name="voidReason" class="form-control" rows="2" required placeholder="Enter reason..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-ban me-2"></i>Void</button>
                </div>
            </form>
        </div>
    </div>
</div>
