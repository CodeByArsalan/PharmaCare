@using PharmaCare.Web.Utilities
@model IEnumerable<PharmaCare.Domain.Entities.Finance.SupplierCreditNote>
@{
    ViewData["Title"] = "Supplier Credit Notes";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h4 class="page-title">
        <i class="fas fa-file-invoice-dollar"></i> Supplier Credit Notes
    </h4>
    <a asp-action="AddSupplierCreditNote" class="btn btn-success">
        <i class="fas fa-plus me-2"></i>New Credit Note
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="scnTable">
                <thead class="bg-theme-header">
                    <tr>
                        <th scope="col" style="width:50px">S.No</th>
                        <th scope="col">Ref No</th>
                        <th scope="col">Date</th>
                        <th scope="col">Supplier</th>
                        <th scope="col">Linked GRN</th>
                        <th scope="col" class="text-end">Amount</th>
                        <th scope="col" class="text-end">Applied</th>
                        <th scope="col" class="text-end">Balance</th>
                        <th scope="col" class="text-center">Status</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int sNo = 1; }
                    @foreach (var cn in Model)
                    {
                        <tr>
                            <td>@(sNo++)</td>
                            <td><strong>@cn.CreditNoteNo</strong></td>
                            <td>@cn.CreditDate.ToString("dd/MM/yyyy")</td>
                            <td>@cn.Party?.Name</td>
                            <td>@(cn.SourceStockMain?.TransactionNo ?? "-")</td>
                            <td class="text-end">@cn.TotalAmount.ToString("N2")</td>
                            <td class="text-end text-muted">@cn.AppliedAmount.ToString("N2")</td>
                            <td class="text-end fw-bold @(cn.BalanceAmount > 0 ? "text-success" : "")">@cn.BalanceAmount.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge bg-@(cn.Status == "Open" ? "success" : cn.Status == "Applied" ? "secondary" : "danger")">
                                    @cn.Status
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-action="ViewSupplierCreditNote" asp-route-id="@cn.SupplierCreditNoteID.EncryptId()" class="btn btn-sm btn-outline-info me-1" title="View credit note" aria-label="View credit note">
                                    <i class="fas fa-eye"></i>
                                </a>
                                @if (cn.Status == "Open")
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#voidModal"
                                            data-id="@cn.SupplierCreditNoteID.EncryptId()"
                                            data-ref="@cn.CreditNoteNo"
                                            title="Void credit note" aria-label="Void credit note">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Void Modal -->
<div class="modal fade" id="voidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Void" method="post">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-ban me-2 text-danger"></i>Void Credit Note</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>You are about to void credit note <strong id="voidRef"></strong>. This action cannot be undone.</p>
                    <input type="hidden" name="id" id="voidId" />
                    <div class="mb-3">
                        <label class="form-label">Void Reason <span class="text-danger">*</span></label>
                        <textarea name="voidReason" class="form-control" rows="2" required placeholder="Enter reason for voiding..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-ban me-2"></i>Void</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if (!$.fn.DataTable.isDataTable('#scnTable')) {
                $('#scnTable').DataTable({ order: [[2, 'desc']], pageLength: 25 });
            }
            $('#voidModal').on('show.bs.modal', function(e) {
                var btn = $(e.relatedTarget);
                $('#voidId').val(btn.data('id'));
                $('#voidRef').text(btn.data('ref'));
            });
        });
    </script>
}
