@model PharmaCare.Application.ViewModels.Report.GlobalSearchResultVM
@{
    ViewData["Title"] = "Search Results";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 mb-4 premium-card">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-shape bg-primary text-white rounded-circle shadow-sm me-3">
                            <i class="fas fa-search"></i>
                        </div>
                        <div>
                            <h4 class="mb-0">Search Results for "@Model.Query"</h4>
                            <p class="text-muted mb-0">Found @Model.TotalResults results across the system</p>
                        </div>
                    </div>

                    @if (Model.TotalResults == 0)
                    {
                        <div class="text-center py-5">
                            <div class="mb-3">
                                <i class="fas fa-search fa-4x text-light"></i>
                            </div>
                            <h5>No matches found</h5>
                            <p class="text-muted">Try using different keywords or checking for spelling errors.</p>
                            <a href="/" class="btn btn-primary mt-3">Return Home</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.TotalResults > 0)
    {
        <div class="row">
            @if (Model.Products.Any())
            {
                <div class="col-md-4 mb-4">
                    <h5 class="mb-3 d-flex align-items-center">
                        <i class="fas fa-box text-info me-2"></i> Products 
                        <span class="badge bg-info ms-2 rounded-pill font-size-xs">@Model.Products.Count</span>
                    </h5>
                    <div class="list-group list-group-flush shadow-sm rounded-3 overflow-hidden">
                        @foreach (var item in Model.Products)
                        {
                            <a href="@item.Url" class="list-group-item list-group-item-action p-3 border-start border-4 border-info">
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <h6 class="mb-1 text-truncate" style="max-width: 200px;">@item.Title</h6>
                                    <span class="badge @item.BadgeClass">@item.Type</span>
                                </div>
                                <small class="text-muted">@item.Subtitle</small>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (Model.Parties.Any())
            {
                <div class="col-md-4 mb-4">
                    <h5 class="mb-3 d-flex align-items-center">
                        <i class="fas fa-users text-primary me-2"></i> Parties 
                        <span class="badge bg-primary ms-2 rounded-pill font-size-xs">@Model.Parties.Count</span>
                    </h5>
                    <div class="list-group list-group-flush shadow-sm rounded-3 overflow-hidden">
                        @foreach (var item in Model.Parties)
                        {
                            <a href="@item.Url" class="list-group-item list-group-item-action p-3 border-start border-4 border-primary">
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <h6 class="mb-1 text-truncate" style="max-width: 200px;">@item.Title</h6>
                                    <span class="badge @item.BadgeClass">@item.Type</span>
                                </div>
                                <small class="text-muted">@item.Subtitle</small>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (Model.Transactions.Any())
            {
                <div class="col-md-4 mb-4">
                    <h5 class="mb-3 d-flex align-items-center">
                        <i class="fas fa-file-invoice-dollar text-success me-2"></i> Transactions 
                        <span class="badge bg-success ms-2 rounded-pill font-size-xs">@Model.Transactions.Count</span>
                    </h5>
                    <div class="list-group list-group-flush shadow-sm rounded-3 overflow-hidden">
                        @foreach (var item in Model.Transactions)
                        {
                            <a href="@item.Url" class="list-group-item list-group-item-action p-3 border-start border-4 border-success">
                                <div class="d-flex w-100 justify-content-between align-items-center">
                                    <h6 class="mb-1 text-truncate" style="max-width: 200px;">@item.Title</h6>
                                    <span class="badge @item.BadgeClass">@item.Type</span>
                                </div>
                                <small class="text-muted">@item.Subtitle</small>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .premium-card {
        border-radius: 12px;
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
    }
    .icon-shape {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .list-group-item {
        transition: all 0.2s ease;
        background-color: #fff;
    }
    .list-group-item:hover {
        transform: translateX(5px);
        background-color: #f1f4f9;
        z-index: 1;
    }
    .font-size-xs {
        font-size: 0.7rem;
    }
</style>
