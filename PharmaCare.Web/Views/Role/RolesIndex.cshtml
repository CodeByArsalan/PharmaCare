@using PharmaCare.Web.Utilities
@model IEnumerable<PharmaCare.Domain.Entities.Security.Role>
@{
    ViewData["Title"] = "Role Management";
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">
        <i class="fas fa-user-shield"></i>
        Role Management
    </h4>
    <a asp-action="AddRole" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Role
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
        <table class="table table-hover datatable">
            <thead>
                <tr>
                    <th scope="col" class="w-60px">S.No</th>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Type</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int count = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(count++)</td>
                        <td><strong>@item.Name</strong></td>
                        <td>@(item.Description ?? "-")</td>
                        <td>
                            @if (item.IsSystemRole)
                            {
                                <span class="badge bg-warning">System</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Custom</span>
                            }
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Permissions" asp-route-id="@item.RoleID.EncryptId()" class="btn btn-sm btn-outline-info" title="Manage Permissions" aria-label="Manage Permissions">
                                <i class="fas fa-key"></i>
                            </a>
                            <a asp-action="EditRole" asp-route-id="@item.RoleID.EncryptId()" class="btn btn-sm btn-outline-primary" title="Edit role" aria-label="Edit role">
                                <i class="fas fa-edit"></i>
                            </a>
                            @if (!item.IsSystemRole)
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning btn-toggle" title="Toggle status" aria-label="Toggle status"
                                        data-id="@item.RoleID.EncryptId()" data-name="@item.Name" data-status="@(item.IsActive ? "deactivate" : "activate")">
                                    <i class="fas fa-power-off"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<!-- Hidden form for toggle status -->
<form id="toggleForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                const status = this.getAttribute('data-status');
                
                Swal.fire({
                    title: status.charAt(0).toUpperCase() + status.slice(1) + ' Role?',
                    text: `Are you sure you want to ${status} "${name}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: status === 'deactivate' ? '#dc2626' : '#10b981',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, ' + status + ' it!',
                    cancelButtonText: 'Cancel',
                    background: 'var(--bg-card)',
                    color: 'var(--text-primary)'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = document.getElementById('toggleForm');
                        form.action = '/Role/ToggleStatus/' + id;
                        form.submit();
                    }
                });
            });
        });
    </script>
}
