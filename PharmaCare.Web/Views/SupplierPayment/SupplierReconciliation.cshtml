@using PharmaCare.Web.Utilities
@{
    ViewData["Title"] = "Supplier Reconciliation";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-balance-scale me-2"></i>Supplier Reconciliation</h6>
    </div>
    <div class="card-body">
        <form method="get" asp-action="SupplierReconciliation">
            <div class="row align-items-end">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Select Supplier <span class="text-danger">*</span></label>
                    <select name="supplierId" class="form-select select2" required asp-items="ViewBag.Suppliers" onchange="this.form.submit()">
                        <option value="">-- Choose Supplier --</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.SelectedSupplier != null)
{
    var grns = (IEnumerable<PharmaCare.Domain.Entities.Transactions.StockMain>)ViewBag.PendingGrns;
    var credits = (IEnumerable<dynamic>)ViewBag.AvailableCredits;

    <div class="row">
        <!-- Left Column: Outstanding GRNs -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow h-100 border-start border-warning border-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-warning"><i class="fas fa-file-invoice me-2"></i>Outstanding GRNs</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="bg-theme-header">
                                <tr>
                                    <th>Ref No</th>
                                    <th>Date</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-end">Outst. Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!grns.Any())
                                {
                                    <tr><td colspan="4" class="text-center text-muted">No outstanding GRNs found.</td></tr>
                                }
                                else
                                {
                                    foreach (var grn in grns)
                                    {
                                        <tr>
                                            <td><strong>@grn.TransactionNo</strong></td>
                                            <td>@grn.TransactionDate.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end">@grn.TotalAmount.ToString("N2")</td>
                                            <td class="text-end fw-bold text-danger">@grn.BalanceAmount.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Available Credits -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow h-100 border-start border-success border-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success"><i class="fas fa-money-check-alt me-2"></i>Available Credits</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead class="bg-theme-header">
                                <tr>
                                    <th>Type</th>
                                    <th>Ref No</th>
                                    <th>Date</th>
                                    <th class="text-end">Available</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!credits.Any())
                                {
                                    <tr><td colspan="5" class="text-center text-muted">No available credits or advances found.</td></tr>
                                }
                                else
                                {
                                    foreach (var credit in credits)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge @(credit.IdType == "Advance" ? "bg-info" : "bg-primary")">
                                                    @credit.IdType
                                                </span>
                                            </td>
                                            <td>@credit.Reference</td>
                                            <td>@credit.Date.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end fw-bold text-success">@credit.AvailableAmount.ToString("N2")</td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-success border-0" 
                                                        title="Apply as Payment"
                                                        onclick="openApplyModal('@credit.Id', '@credit.IdType', '@credit.Reference', @credit.AvailableAmount)">
                                                    <i class="fas fa-check-circle"></i> Apply
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Apply Credit Modal -->
    <div class="modal fade" id="applyModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title"><i class="fas fa-link me-2"></i>Apply Credit</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="ApplyCredit" method="post">
                    <div class="modal-body p-4">
                        <input type="hidden" id="modalCreditId" name="creditId" />
                        <input type="hidden" id="modalCreditType" name="creditType" />
                        
                        <div class="alert alert-info py-2 mb-4 d-flex align-items-center">
                            <i class="fas fa-info-circle fs-4 me-3"></i>
                            <div>
                                <div class="small fw-bold">Applying <span id="lblCreditType"></span></div>
                                <div class="text-primary">Ref: <strong id="lblCreditRef"></strong></div>
                                <div class="small">Available: <strong><span id="lblCreditAvailable"></span></strong></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Allocate to GRN <span class="text-danger">*</span></label>
                            <select name="grnId" id="modalGrnId" class="form-select" required onchange="onGrnSelected()">
                                <option value="">-- Select Outstanding GRN --</option>
                                @foreach (var grn in grns)
                                {
                                    <option value="@grn.StockMainID.EncryptId()" data-balance="@grn.BalanceAmount">
                                        @grn.TransactionNo (Balance: @grn.BalanceAmount.ToString("N2"))
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Allocation Amount <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">Rs</span>
                                <input type="number" step="0.01" min="0.01" name="amount" id="modalAmount" class="form-control" required />
                            </div>
                            <small class="text-muted">Will default to the smaller of the GRN balance or the available credit.</small>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0">
                        <button type="button" class="btn btn-light shadow-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary shadow-sm px-4">
                            <i class="fas fa-check me-2"></i>Apply Credit
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.select2').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Search supplier...'
            });
        });

        let currentAvailable = 0;

        function openApplyModal(id, type, ref, available) {
            $('#modalCreditId').val(id);
            $('#modalCreditType').val(type);
            $('#lblCreditType').text(type === 'Advance' ? 'Advance Payment' : 'Supplier Credit Note');
            $('#lblCreditRef').text(ref);
            $('#lblCreditAvailable').text(parseFloat(available).toFixed(2));
            
            currentAvailable = parseFloat(available);
            
            // Reset form
            $('#modalGrnId').val('');
            $('#modalAmount').val('');
            
            $('#applyModal').modal('show');
        }

        function onGrnSelected() {
            const selectedOpt = $('#modalGrnId').find(':selected');
            if (!selectedOpt.val()) {
                $('#modalAmount').val('');
                return;
            }
            
            const grnBalance = parseFloat(selectedOpt.data('balance'));
            // Default to the smaller of available credit or outstanding balance
            const allocation = Math.min(grnBalance, currentAvailable);
            
            $('#modalAmount').val(allocation.toFixed(2));
            // Apply bounds checking
            $('#modalAmount').attr('max', currentAvailable);
        }
        
        // Ensure max client-side validation dynamically checks grn limit too
        $('#modalAmount').on('input', function() {
            const val = parseFloat($(this).val()) || 0;
            const selectedOpt = $('#modalGrnId').find(':selected');
            const grnBalance = parseFloat(selectedOpt.data('balance')) || 0;
            
            const upperLimit = Math.min(grnBalance, currentAvailable);
            if (val > upperLimit) {
                $(this).val(upperLimit.toFixed(2));
            }
        });
    </script>
}
