@using PharmaCare.Web.Utilities
@model PharmaCare.Application.DTOs.PagedResult<PharmaCare.Domain.Entities.Configuration.Party>
@{
    ViewData["Title"] = "Party Management";
    var search = ViewBag.Search as string;
    var selectedType = ViewBag.SelectedType as string ?? "All";
    var selectedStatus = ViewBag.SelectedStatus as int?;
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">
        <i class="fas fa-users"></i>
        Party Management
    </h4>
    <a asp-action="AddParty" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Party
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light">
        <form method="get" asp-action="PartiesIndex" class="row gx-3 gy-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">Search</label>
                <input type="text" name="search" class="form-control" value="@search" placeholder="Name, phone or email..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Type</label>
                <select name="partyType" class="form-select">
                    <option value="All" selected="@(selectedType == "All")">All</option>
                    <option value="Customer" selected="@(selectedType == "Customer")">Customer</option>
                    <option value="Supplier" selected="@(selectedType == "Supplier")">Supplier</option>
                    <option value="Both" selected="@(selectedType == "Both")">Both</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Status</label>
                <select name="status" class="form-select">
                    <option value="" selected="@(selectedStatus == null)">All</option>
                    <option value="1" selected="@(selectedStatus == 1)">Active</option>
                    <option value="0" selected="@(selectedStatus == 0)">Inactive</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.TotalCount > 0)
        {
            @await Html.PartialAsync("_PagerTop", Model)
        }
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th style="width: 60px;">S.No</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    var sno = ((Model.CurrentPage - 1) * Model.PageSize) + 1;
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(sno++)</td>
                            <td><strong>@item.Name</strong></td>
                            <td>
                                @if (item.PartyType == "Customer")
                                {
                                    <span class="badge bg-info">Customer</span>
                                }
                                else if (item.PartyType == "Supplier")
                                {
                                    <span class="badge bg-warning">Supplier</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.PartyType</span>
                                }
                            </td>
                            <td>@(item.Phone ?? "-")</td>
                            <td>@(item.Email ?? "-")</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="EditParty" asp-route-id="@item.PartyID.EncryptId()" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete"
                                        data-id="@item.PartyID.EncryptId()" data-name="@item.Name">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <div class="empty-state">
                                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                                <p class="mb-0">No parties found.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalCount > 0)
    {
        @await Html.PartialAsync("_Pager", Model)
    }
</div>

<!-- Hidden form for delete -->
<form id="deleteForm" method="post" style="display: none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-delete').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                const name = this.getAttribute('data-name');
                
                Swal.fire({
                    title: 'Delete Party?',
                    text: `Are you sure you want to delete "${name}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel',
                    background: '#1e293b',
                    color: '#f1f5f9'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const form = document.getElementById('deleteForm');
                        form.action = '/Party/Delete/' + id;
                        form.submit();
                    }
                });
            });
        });
    </script>
}
