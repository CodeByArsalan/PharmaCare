@model PharmaCare.Application.DTOs.PagedResult<PharmaCare.Domain.Entities.Transactions.Voucher>
@{
    ViewData["Title"] = "Journal Vouchers";
    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<div class="page-header">
    <h4 class="page-title">
        <i class="fas fa-book"></i> Journal Vouchers
    </h4>
    <a asp-action="AddJournalVoucher" class="btn btn-primary">
        <i class="fas fa-plus"></i> New Voucher
    </a>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light">
        <form method="get" asp-action="JournalVoucherIndex" class="row gx-3 gy-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small fw-bold text-muted">Search</label>
                <input type="text" name="search" class="form-control" value="@search" placeholder="Voucher no or narration..." />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted">Status</label>
                <select name="status" class="form-select">
                    <option value="All" selected="@(string.IsNullOrEmpty(selectedStatus) || selectedStatus == "All")">All</option>
                    <option value="Posted" selected="@(selectedStatus == "Posted")">Posted</option>
                    <option value="Reversed" selected="@(selectedStatus == "Reversed")">Voided</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.TotalCount > 0)
        {
            @await Html.PartialAsync("_PagerTop", Model)
        }
        <div class="table-responsive">
            <table class="table table-hover" id="vouchersTable">
                <thead class="bg-theme-header">
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Voucher No</th>
                        <th scope="col">Narration</th>
                        <th scope="col" class="text-end">Amount</th>
                        <th scope="col" class="text-center">Status</th>
                        <th scope="col" class="text-center">Created By</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">No journal vouchers found.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsReversed ? "text-muted text-decoration-line-through" : "")">
                            <td>@item.VoucherDate.ToString("dd-MM-yyyy")</td>
                            <td>@item.VoucherNo</td>
                            <td>@item.Narration</td>
                            <td class="text-end">@item.TotalDebit.ToString("N2")</td>
                            <td class="text-center">
                                @if(item.IsReversed)
                                {
                                    <span class="badge bg-danger">Voided</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Posted</span>
                                }
                            </td>
                            <td class="text-center">
                                @(ViewBag.UserNames != null && ViewBag.UserNames.ContainsKey(item.CreatedBy) 
                                    ? ViewBag.UserNames[item.CreatedBy] 
                                    : $"User {item.CreatedBy}")
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Posted" && !item.IsReversed && item.ReversedByVoucher_ID == null && item.ReversesVoucher_ID == null)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                            onclick="openVoidModal('@PharmaCare.Web.Utilities.Utility.EncryptId(item.VoucherID)', '@item.VoucherNo')">
                                        <i class="fas fa-ban"></i> Void
                                    </button>
                                }
                                else if (item.IsReversed)
                                {
                                    <span class="text-muted small">Reversed by @item.ReversedByVoucher_ID</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalCount > 0)
    {
        @await Html.PartialAsync("_Pager", Model)
    }
</div>

<!-- Void Modal -->
<div class="modal fade" id="voidModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="ReverseJournalVoucher" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Void Voucher</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to void voucher <strong id="voidVoucherNo"></strong>?</p>
                    <input type="hidden" name="id" id="voidVoucherId" />
                    <div class="mb-3">
                        <label class="form-label">Reason for Voiding <span class="text-danger">*</span></label>
                        <textarea name="voidReason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Void</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Server-side paging is used; client-side DataTables init removed.
        function openVoidModal(id, no) {
            $('#voidVoucherId').val(id);
            $('#voidVoucherNo').text(no);
            var modal = new bootstrap.Modal(document.getElementById('voidModal'));
            modal.show();
        }
    </script>
}
