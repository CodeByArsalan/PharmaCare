@model PharmaCare.Application.ViewModels.Report.ExpenseReportVM
@{
    ViewData["Title"] = "Expense Report";
}

<div class="page-header">
    <h4 class="page-title"><i class="fas fa-receipt"></i> Expense Report</h4>
    <a asp-action="FinancialReportIndex" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back to Reports</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label">From Date</label>
                <input type="date" name="filter.FromDate" class="form-control" value="@Model.Filter.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">To Date</label>
                <input type="date" name="filter.ToDate" class="form-control" value="@Model.Filter.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i>Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Expense Details</h5></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="reportTable" class="table table-striped table-hover">
                        <thead>
                            <tr><th>S.No</th><th>Date</th><th>Category</th><th>Description</th><th>Amount</th><th>Source Account</th><th>Reference</th></tr>
                        </thead>
                        <tbody>
                            @{ int sno = 1; }
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td>@(sno++)</td>
                                    <td>@row.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                    <td>@row.CategoryName</td>
                                    <td>@row.Description</td>
                                    <td class="text-end">@row.Amount.ToString("N2")</td>
                                    <td>@row.SourceAccountName</td>
                                    <td>@row.Reference</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold"><td colspan="4" class="text-end">Grand Total:</td><td class="text-end">@Model.GrandTotal.ToString("N2")</td><td colspan="2"></td></tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-4 border-0 shadow-sm">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center" style="background: var(--glass-bg)">
                <h5 class="mb-0 fw-bold">Budget vs Actual</h5>
                <a asp-controller="Expense" asp-action="BudgetManagement" class="btn btn-sm btn-outline-primary" title="Manage Budgets">
                    <i class="fas fa-cog"></i>
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr style="background: var(--glass-bg)">
                                <th class="ps-3 py-2">Category</th>
                                <th class="text-end py-2">Spend / Budget</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model.CategoryTotals)
                            {
                                var percentage = cat.BudgetAmount > 0 ? (cat.Amount / cat.BudgetAmount) * 100 : 0;
                                var progressClass = percentage > 100 ? "bg-danger" : (percentage > 85 ? "bg-warning" : "bg-success");
                                
                                <tr>
                                    <td class="ps-3 py-3">
                                        <div class="fw-bold mb-1">@cat.CategoryName</div>
                                        <div class="progress" style="height: 6px; background: var(--bg-dark)">
                                            <div class="progress-bar @progressClass" role="progressbar" style="width: @(Math.Min(100, percentage))%"></div>
                                        </div>
                                    </td>
                                    <td class="text-end pe-3 py-3">
                                        <div class="fw-bold">@cat.Amount.ToString("N0")</div>
                                        <div class="small text-muted">of @cat.BudgetAmount.ToString("N0")</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="fw-bold border-top" style="background: var(--glass-bg)">
                            <tr>
                                <td class="ps-3 py-3">Total Utilization</td>
                                @{
                                    var totalBudget = Model.CategoryTotals.Sum(x => x.BudgetAmount);
                                    var totalPercentage = totalBudget > 0 ? (Model.GrandTotal / totalBudget) * 100 : 0;
                                }
                                <td class="text-end pe-3 py-3">
                                    <div class="@(Model.GrandTotal > totalBudget && totalBudget > 0 ? "text-danger" : "text-primary")">
                                        @totalPercentage.ToString("N1")%
                                    </div>
                                    <div class="small text-muted">@Model.GrandTotal.ToString("N0") / @totalBudget.ToString("N0")</div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header border-bottom" style="background: var(--glass-bg)">
                <h5 class="mb-0 fw-bold">Expense Distribution</h5>
            </div>
            <div class="card-body d-flex flex-column justify-content-center" style="min-height: 350px;">
                <div class="position-relative" style="height: 250px;">
                    <canvas id="expenseChart"></canvas>
                    <div id="chartCenterText" class="position-absolute top-50 start-50 translate-middle text-center" style="pointer-events: none;">
                        <div class="small text-muted">Total</div>
                        <div class="fw-bold h5 mb-0">@Model.GrandTotal.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.DataTable) {
                new DataTable('#reportTable', { order: [[0, 'asc']], pageLength: 25 });
            }
            
            const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
            const textColor = isDark ? '#cbd5e1' : '#475569';
            const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryTotals.OrderByDescending(x => x.Amount)));
            
            const ctx = document.getElementById('expenseChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: catData.map(c => c.categoryName),
                        datasets: [{ 
                            data: catData.map(c => c.amount), 
                            backgroundColor: [
                                '#0ea5e9', '#10b981', '#f59e0b', '#ef4444', 
                                '#8b5cf6', '#06b6d4', '#f97316', '#64748b'
                            ],
                            borderColor: isDark ? '#1e293b' : '#fff',
                            borderWidth: 2,
                            hoverOffset: 15
                        }]
                    },
                    options: { 
                        responsive: true, 
                        maintainAspectRatio: false,
                        cutout: '75%',
                        plugins: { 
                            legend: { 
                                position: 'bottom',
                                labels: {
                                    color: textColor,
                                    usePointStyle: true,
                                    padding: 15,
                                    font: { family: 'Inter', size: 11 }
                                }
                            },
                            tooltip: {
                                backgroundColor: isDark ? '#0f172a' : '#fff',
                                titleColor: isDark ? '#fff' : '#0f172a',
                                bodyColor: isDark ? '#cbd5e1' : '#475569',
                                borderColor: 'rgba(255,255,255,0.1)',
                                borderWidth: 1,
                                padding: 12,
                                callbacks: {
                                    label: function(context) {
                                        let label = context.label || '';
                                        if (label) label += ': ';
                                        if (context.parsed !== null) {
                                            label += new Intl.NumberFormat('en-US', { style: 'currency', currency: appCurrencyCode() }).format(context.parsed);
                                        }
                                        return label;
                                    }
                                }
                            }
                        } 
                    }
                });
            }
        });
    </script>
}
