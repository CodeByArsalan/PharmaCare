@model PharmaCare.Application.ViewModels.Report.ProfitLossVM
@{
    ViewData["Title"] = "Profit & Loss";
}

<div class="page-header">
    <h4 class="page-title"><i class="fas fa-chart-line"></i> Profit & Loss Statement</h4>
    <a asp-action="FinancialReportIndex" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Back to Reports</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label">From Date</label>
                <input type="date" name="filter.FromDate" class="form-control" value="@Model.Filter.FromDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label">To Date</label>
                <input type="date" name="filter.ToDate" class="form-control" value="@Model.Filter.ToDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i>Generate</button>
            </div>
        </form>
    </div>
</div>

<!-- P&L Statement -->
<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header"><h5 class="mb-0">Income Statement</h5></div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <tbody>
                        <tr style="background: var(--glass-bg)" class="fw-bold"><td colspan="2" class="py-3">REVENUE</td></tr>
                        <tr><td class="ps-4">Gross Sales</td><td class="text-end">@Model.TotalRevenue.ToString("N2")</td></tr>
                        <tr><td class="ps-4">Less: Sales Returns</td><td class="text-end text-danger">(@Model.SalesReturns.ToString("N2"))</td></tr>
                        <tr class="fw-bold" style="background: rgba(var(--primary-500-rgb, 14, 165, 233), 0.05)"><td class="ps-4">Net Revenue</td><td class="text-end">@Model.NetRevenue.ToString("N2")</td></tr>
                        
                        <tr style="background: var(--glass-bg)" class="fw-bold"><td colspan="2" class="py-3">COST OF GOODS SOLD</td></tr>
                        <tr><td class="ps-4">COGS (Direct Costs)</td><td class="text-end">@Model.COGS.ToString("N2")</td></tr>
                        <tr class="fw-bold" style="background: rgba(var(--secondary-500-rgb, 16, 185, 129), 0.05)">
                            <td class="ps-4">Gross Profit</td>
                            <td class="text-end text-success">
                                @Model.GrossProfit.ToString("N2") 
                                <span class="badge bg-success ms-2">@Model.GrossProfitMargin%</span>
                            </td>
                        </tr>
                        
                        <tr style="background: var(--glass-bg)" class="fw-bold"><td colspan="2" class="py-3">OPERATING EXPENSES</td></tr>
                        @foreach (var exp in Model.ExpensesByCategory)
                        {
                            <tr>
                                <td class="ps-4 text-secondary">@exp.CategoryName</td>
                                <td class="text-end">
                                    @exp.Amount.ToString("N2")
                                    @if (exp.BudgetAmount > 0)
                                    {
                                        <div class="small text-muted mt-1">Budget: @exp.BudgetAmount.ToString("N0")</div>
                                    }
                                </td>
                            </tr>
                        }
                        <tr class="fw-bold" style="background: rgba(var(--danger-500-rgb, 239, 68, 68), 0.05)">
                            <td class="ps-4">Total Operating Expenses</td>
                            <td class="text-end text-danger">@Model.TotalExpenses.ToString("N2")</td>
                        </tr>

                        <tr class="fw-bold fs-5" style="border-top: 2px solid var(--glass-border); background: @(Model.NetProfit >= 0 ? "rgba(16, 185, 129, 0.1)" : "rgba(239, 68, 68, 0.1)")">
                            <td class="py-3 ps-3">@(Model.NetProfit >= 0 ? "Net Profit" : "Net Loss")</td>
                            <td class="text-end py-3 pe-3 @(Model.NetProfit >= 0 ? "text-success" : "text-danger")">
                                @Model.NetProfit.ToString("N2")
                                <span class="badge @(Model.NetProfit >= 0 ? "bg-success" : "bg-danger") ms-2">@Model.NetProfitMargin%</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Chart -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><h5 class="mb-0">Breakdown</h5></div>
            <div class="card-body">
                <canvas id="plChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
            const textColor = isDark ? '#cbd5e1' : '#475569';

            new Chart(document.getElementById('plChart'), {
                type: 'doughnut',
                data: {
                    labels: ['COGS', 'Operating Expenses', 'Net Profit'],
                    datasets: [{
                        data: [@Model.COGS, @Model.TotalExpenses, @Math.Max(0, Model.NetProfit)],
                        backgroundColor: [
                            'rgba(245, 158, 11, 0.8)', // Warning (COGS)
                            'rgba(239, 68, 68, 0.8)',   // Danger (Expenses)
                            'rgba(16, 185, 129, 0.8)'  // Success (Profit)
                        ],
                        borderColor: isDark ? '#1e293b' : '#fff',
                        borderWidth: 2,
                        hoverOffset: 15
                    }]
                },
                options: { 
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: { 
                        legend: { 
                            position: 'bottom',
                            labels: {
                                color: textColor,
                                usePointStyle: true,
                                padding: 20,
                                font: { family: 'Inter', size: 12 }
                            }
                        },
                        tooltip: {
                            backgroundColor: isDark ? '#0f172a' : '#fff',
                            titleColor: isDark ? '#fff' : '#0f172a',
                            bodyColor: isDark ? '#cbd5e1' : '#475569',
                            borderColor: 'rgba(255,255,255,0.1)',
                            borderWidth: 1,
                            padding: 12,
                            displayColors: true,
                            callbacks: {
                                label: function(context) {
                                    let label = context.label || '';
                                    if (label) label += ': ';
                                    if (context.parsed !== null) {
                                        label += new Intl.NumberFormat('en-US', { style: 'currency', currency: appCurrencyCode() }).format(context.parsed);
                                    }
                                    return label;
                                }
                            }
                        }
                    } 
                }
            });
        });
    </script>
}
