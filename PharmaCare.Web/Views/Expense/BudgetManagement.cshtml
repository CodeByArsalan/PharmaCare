@using PharmaCare.Application.ViewModels.Report
@model IEnumerable<ExpenseBudgetVM>
@{
    ViewData["Title"] = "Expense Budget Management";
    int currentYear = ViewBag.Year;
    int currentMonth = ViewBag.Month;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-0 text-gray-800">Expense Budget Management</h1>
                <p class="text-muted small">Set monthly budgets for each expense category to track variances in reports.</p>
            </div>
            <a asp-action="ExpenseCategoriesIndex" class="btn btn-outline-secondary">
                <i class="fas fa-list me-2"></i>Categories
            </a>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-light">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="form-label mb-0 fw-bold">Period:</label>
                </div>
                <div class="col-auto">
                    <select name="month" class="form-select form-select-sm" onchange="this.form.submit()">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == currentMonth)">@System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(m)</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                        @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                        {
                            <option value="@y" selected="@(y == currentYear)">@y</option>
                        }
                    </select>
                </div>
                <div class="col-auto ms-auto text-muted small">
                    <i class="fas fa-info-circle me-1"></i> Changes are saved only when you click "Save All Budgets"
                </div>
            </form>
        </div>
        <div class="card-body">
            <form asp-action="BudgetManagement" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@currentYear" />
                <input type="hidden" name="month" value="@currentMonth" />

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 300px;">Expense Category</th>
                                <th style="width: 250px;">Budget Amount (@CurrencyDisplay.Symbol)</th>
                                <th>Remarks / Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var budgetList = Model.ToList();
                            }
                            @for (int i = 0; i < budgetList.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" name="budgets[@i].CategoryId" value="@budgetList[i].CategoryId" />
                                        <input type="hidden" name="budgets[@i].CategoryName" value="@budgetList[i].CategoryName" />
                                        <span class="fw-bold text-dark">@budgetList[i].CategoryName</span>
                                    </td>
                                    <td>
                                        <div class="input-group">
                                            <span class="input-group-text">Rs.</span>
                                            <input type="number" name="budgets[@i].BudgetAmount" value="@budgetList[i].BudgetAmount" 
                                                   class="form-control text-end" step="0.01" min="0" />
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text" name="budgets[@i].Remarks" value="@budgetList[i].Remarks" 
                                               class="form-control" placeholder="Optional notes..." />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary px-4 py-2">
                        <i class="fas fa-save me-2"></i>Save All Budgets
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Highlight row on input focus
            $('input').focus(function() {
                $(this).closest('tr').addClass('table-primary-subtle');
            }).blur(function() {
                $(this).closest('tr').removeClass('table-primary-subtle');
            });
        });
    </script>
}
