@model PharmaCare.Application.DTOs.PagedResult<PharmaCare.Domain.Entities.Finance.Expense>
@using PharmaCare.Web.Utilities
@{
    ViewData["Title"] = "Expense Management";
}

<!-- Page Header -->
<div class="page-header">
    <h4 class="page-title">
        <i class="fas fa-file-invoice-dollar"></i>
        Expense Management
    </h4>
    <div>
        <a asp-action="ExpenseCategoriesIndex" class="btn btn-outline-secondary me-2">
            <i class="fas fa-tags me-2"></i>Categories
        </a>
        <a asp-action="AddExpense" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Record Expense
        </a>
    </div>
</div>

<div class="card mb-4 shadow-sm border-0">
    <div class="card-body bg-light">
        <form method="get" asp-action="ExpensesIndex" class="row gx-3 gy-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Category</label>
                <select name="categoryId" class="form-select select2" asp-items="ViewBag.Categories">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")" />
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.TotalCount > 0)
        {
            @await Html.PartialAsync("_PagerTop", Model)
        }
        <div class="table-responsive">
        <table class="table mb-0" id="expensesTable">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Category</th>
                    <th scope="col">Description</th>
                    <th scope="col">Vendor</th>
                    <th scope="col">Source Account</th>
                    <th scope="col" class="text-end">Amount</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        var isVoided = item.Voucher != null && item.Voucher.IsReversed;
                        <tr class="@(isVoided ? "table-danger opacity-75" : "")">
                            <td>@item.ExpenseDate.ToString("dd/MM/yyyy")</td>
                            <td><strong>@item.ExpenseCategory?.Name</strong></td>
                            <td>@(item.Description ?? "—")</td>
                            <td>@(item.VendorName ?? "—")</td>
                            <td>@item.SourceAccount?.Name</td>
                            <td class="text-end fw-bold">@item.Amount.ToString("N2")</td>
                            <td>
                                @if (item.Status == PharmaCare.Domain.Enums.TransactionStatus.Void)
                                {
                                    <span class="badge bg-danger cursor-pointer" data-bs-toggle="tooltip" title="Reason: @(item.VoidReason ?? "No reason provided")">Voided</span>
                                }
                                else if (item.Status == PharmaCare.Domain.Enums.TransactionStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Draft</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="ViewExpense" asp-route-id="@Utility.EncryptId(item.ExpenseID)"
                                       class="btn btn-sm btn-outline-primary" title="View" aria-label="View expense">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    
                                    @if (item.Status == PharmaCare.Domain.Enums.TransactionStatus.Draft)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success btn-approve"
                                                data-id="@Utility.EncryptId(item.ExpenseID)"
                                                data-desc="@(item.Description ?? item.ExpenseCategory?.Name)" title="Approve" aria-label="Approve expense">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }

                                    @if (item.Status != PharmaCare.Domain.Enums.TransactionStatus.Void)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-void"
                                                data-id="@Utility.EncryptId(item.ExpenseID)"
                                                data-desc="@(item.Description ?? item.ExpenseCategory?.Name)" title="Void" aria-label="Void expense">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
        @if (Model.TotalCount > 0)
        {
            @await Html.PartialAsync("_Pager", Model)
        }
    </div>
</div>

<!-- Hidden forms -->
<form id="approveForm" method="post" asp-action="Approve" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="approveId" />
</form>

<form id="voidForm" method="post" asp-action="Void" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="voidId" />
    <input type="hidden" name="voidReason" id="voidReason" />
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Select2 is initialized globally by select2-global.js (width:100%) — no re-init here.

            if (!$.fn.DataTable.isDataTable('#expensesTable')) {
                $('#expensesTable').DataTable({
                    order: [[0, 'desc']],
                    paging: false,
                    info: false,
                    searching: false
                });
            }

            // Approve Handler
            document.querySelectorAll('.btn-approve').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const desc = this.getAttribute('data-desc');

                    Swal.fire({
                        title: 'Approve Expense?',
                        text: `Are you sure you want to approve "${desc}" and post it to accounting?`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#10b981',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Yes, approve it!',
                        cancelButtonText: 'Cancel',
                        background: 'var(--bg-card)',
                        color: 'var(--text-primary)'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.getElementById('approveId').value = id;
                            document.getElementById('approveForm').submit();
                        }
                    });
                });
            });

            // Void Handler
            document.querySelectorAll('.btn-void').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const desc = this.getAttribute('data-desc');

                    Swal.fire({
                        title: 'Void Expense?',
                        text: `Are you sure you want to void "${desc}"?`,
                        input: 'textarea',
                        inputPlaceholder: 'Enter reason for voiding...',
                        inputValidator: (value) => {
                            if (!value) return 'Void reason is required.';
                        },
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc2626',
                        cancelButtonColor: '#64748b',
                        confirmButtonText: 'Yes, void it!',
                        cancelButtonText: 'Cancel',
                        background: 'var(--bg-card)',
                        color: 'var(--text-primary)'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.getElementById('voidId').value = id;
                            document.getElementById('voidReason').value = result.value;
                            document.getElementById('voidForm').submit();
                        }
                    });
                });
            });
        });
    </script>
}
