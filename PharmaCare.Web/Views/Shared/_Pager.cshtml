@model PharmaCare.Application.DTOs.IPagedResult
@{
    // Bottom pager bar: range summary (left) + prev/next (right).
    // The page-size selector lives in _PagerTop (rendered above the table, DataTables-style).
    // Preserves all current query-string filters; only overrides page.
    var request = ViewContext.HttpContext.Request;
    var preserved = request.Query
        .Where(kv => kv.Key != "page" && !string.IsNullOrEmpty(kv.Value))
        .ToDictionary(kv => kv.Key, kv => kv.Value.ToString());

    Func<int, string> pageUrl = (pg) =>
    {
        var parts = preserved
            .Where(kv => kv.Key != "pageSize")
            .Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}")
            .ToList();
        parts.Add($"page={pg}");
        parts.Add($"pageSize={Model.PageSize}");
        return request.Path + "?" + string.Join("&", parts);
    };

    var from = Model.TotalCount == 0 ? 0 : ((Model.CurrentPage - 1) * Model.PageSize) + 1;
    var to = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
}

<div class="card-footer bg-theme-footer py-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="text-muted small text-nowrap">
            Showing <strong>@from</strong>–<strong>@to</strong> of <strong>@Model.TotalCount</strong> entries
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@pageUrl(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">Page @Model.CurrentPage of @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@pageUrl(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
