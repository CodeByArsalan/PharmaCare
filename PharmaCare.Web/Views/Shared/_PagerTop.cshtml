@model PharmaCare.Application.DTOs.IPagedResult
@{
    // Top toolbar (DataTables-style "Show N entries"), rendered directly above the table.
    // Preserves all current query-string filters; resets to page 1 with the chosen size.
    var request = ViewContext.HttpContext.Request;
    var preserved = request.Query
        .Where(kv => kv.Key != "page" && kv.Key != "pageSize" && !string.IsNullOrEmpty(kv.Value))
        .ToDictionary(kv => kv.Key, kv => kv.Value.ToString());

    Func<int, string> sizeUrl = (size) =>
    {
        var parts = preserved
            .Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}")
            .ToList();
        parts.Add("page=1");
        parts.Add($"pageSize={size}");
        return request.Path + "?" + string.Join("&", parts);
    };

    var pageSizes = new[] { 10, 25, 50, 100 };
}

<div class="d-flex flex-nowrap align-items-center gap-2 text-muted small text-nowrap px-3 py-2 border-bottom">
    <span>Show</span>
    @* no-select2: keep this a small native dropdown (the global Select2 widens selects to 100%) *@
    <select class="form-select form-select-sm w-auto no-select2" aria-label="Entries per page"
            onchange="if (this.value) { window.location.href = this.value; }">
        @foreach (var s in pageSizes)
        {
            <option value="@sizeUrl(s)" selected="@(s == Model.PageSize)">@s</option>
        }
    </select>
    <span>entries</span>
</div>
