@{
    ViewData["Title"] = "Transaction Not Found";
    Layout = "_Layout";
}

<div class="row min-vh-50 align-items-center justify-content-center text-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 bg-dark mb-4">
            <div class="card-body p-5">
                <i class="fas fa-exclamation-triangle text-warning fa-4x mb-4"></i>
                <h1 class="display-5 text-white fw-bold mb-3">404</h1>
                <h3 class="text-white mb-3">Transaction Not Found</h3>
                <p class="text-muted mb-4">
                    The requested record, receipt, or resource could not be found. It may have been voided, deleted, or you might have navigated to an invalid address.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <button class="btn btn-primary px-4" onclick="window.history.back()">
                        <i class="fas fa-arrow-left me-2"></i> Go Back
                    </button>
                    <a href="~/" class="btn btn-outline-light px-4">
                        <i class="fas fa-home me-2"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
