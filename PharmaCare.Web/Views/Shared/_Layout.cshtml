<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmaCare</title>
    <!-- Resource hints: warm up TLS/DNS for CDN origins used by some pages -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/datatables-bs5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Sidebar (dynamic based on user permissions) -->
    @await Html.PartialAsync("_Sidebar")
    
    <!-- Main Content Area -->
    <div class="main-wrapper">
        <!-- Header with user menu -->
        @await Html.PartialAsync("_Header")
        
        <!-- Page Content -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>
    
    <!-- Scroll to Top Button -->
    <button id="scrollToTopBtn" class="scroll-to-top" title="Go to top">
        <i class="fas fa-arrow-up"></i>
    </button>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap production bundle from CDN (already allowed by the CSP script-src). The old
         local ~/assets/js/bootstrap.js was a webpack dev build using eval-based sourcemaps,
         which the Content-Security-Policy blocks (EvalError). -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/select2-global.js" asp-append-version="true"></script>
    <script src="~/js/datatable-init.js" asp-append-version="true"></script>
    <!-- Chart.js is loaded per-page (only on chart/report views) via @@section Scripts, not globally. -->
    <script src="~/js/premium-interactions.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_ToastNotifications")
    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- Form submit interceptor: prevents double-submits and shows the shared .btn-loading
         state (spinner) on the submit button, preserving its label/width across all variants. -->
    <script>
        $(document).ready(function() {
            $('form').on('submit', function() {
                var $form = $(this);
                if ($form[0].checkValidity && !$form[0].checkValidity()) {
                    return true;
                }
                var $btn = $form.find('button[type="submit"]');
                if ($btn.length > 0 && !$btn.prop('disabled')) {
                    $btn.addClass('btn-loading').attr('aria-busy', 'true').prop('disabled', true);
                }
            });
        });
    </script>
</body>
</html>
