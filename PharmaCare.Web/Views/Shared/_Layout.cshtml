<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Display currency for page scripts (read via appCurrency()/appCurrencyCode() in site JS) -->
    <meta name="app-currency-symbol" content="@CurrencyDisplay.Symbol" />
    <meta name="app-currency-code" content="@CurrencyDisplay.Code" />
    <title>@ViewData["Title"] - PharmaCare</title>
    <!-- All frontend assets are vendored locally (wwwroot/lib) so the POS works without internet. -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/datatables-bs5/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="~/lib/inter/inter.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Sidebar (dynamic based on user permissions) -->
    @await Html.PartialAsync("_Sidebar")
    
    <!-- Main Content Area -->
    <div class="main-wrapper">
        <!-- Header with user menu -->
        @await Html.PartialAsync("_Header")
        
        <!-- Page Content -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>
    
    <!-- Scroll to Top Button -->
    <button id="scrollToTopBtn" class="scroll-to-top" title="Go to top">
        <i class="fas fa-arrow-up"></i>
    </button>
    
    <!-- Currency helpers for page scripts: values come from the layout meta tags (config-driven). -->
    <script>
        function appCurrency() { return document.querySelector('meta[name="app-currency-symbol"]').content; }
        function appCurrencyCode() { return document.querySelector('meta[name="app-currency-code"]').content; }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap production bundle, vendored locally. (The old ~/assets/js/bootstrap.js was a
         webpack dev build using eval-based sourcemaps, which the CSP blocks — don't revive it.) -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/js/select2-global.js" asp-append-version="true"></script>
    <script src="~/js/datatable-init.js" asp-append-version="true"></script>
    <!-- Chart.js is loaded per-page (only on chart/report views) via @@section Scripts, not globally. -->
    <script src="~/js/premium-interactions.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_ToastNotifications")
    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- Form submit interceptor: prevents double-submits and shows the shared .btn-loading
         state (spinner) on the submit button, preserving its label/width across all variants. -->
    <script>
        $(document).ready(function() {
            $('form').on('submit', function() {
                var $form = $(this);
                if ($form[0].checkValidity && !$form[0].checkValidity()) {
                    return true;
                }
                var $btn = $form.find('button[type="submit"]');
                if ($btn.length > 0 && !$btn.prop('disabled')) {
                    $btn.addClass('btn-loading').attr('aria-busy', 'true').prop('disabled', true);
                }
            });
        });
    </script>
</body>
</html>
